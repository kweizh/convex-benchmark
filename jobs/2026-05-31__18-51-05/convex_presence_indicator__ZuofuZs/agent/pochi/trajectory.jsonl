{"type":"message-part","messageId":"a20e68a0-a593-4db5-bb28-a27633d5f2f9","role":"assistant","index":21,"part":{"type":"tool-writeToFile","toolCallId":"TeLbyWdUlBqoKFXl","state":"output-available","input":{"path":"/home/user/presence-app/convex/presence.ts","content":"import { mutation, query } from \"./_generated/server\";\nimport { v } from \"convex/values\";\n\nexport const heartbeat = mutation({\n  args: { user_id: v.string() },\n  handler: async (ctx, args) => {\n    const existing = await ctx.db\n      .query(\"presence\")\n      .withIndex(\"by_user_id\", (q) => q.eq(\"user_id\", args.user_id))\n      .unique();\n\n    if (existing) {\n      await ctx.db.patch(existing._id, { updated_at: Date.now() });\n    } else {\n      await ctx.db.insert(\"presence\", {\n        user_id: args.user_id,\n        updated_at: Date.now(),\n      });\n    }\n  },\n});\n\nexport const getOnlineUsers = query({\n  args: {},\n  handler: async (ctx) => {\n    const fifteenSecondsAgo = Date.now() - 15000;\n    const onlineUsers = await ctx.db\n      .query(\"presence\")\n      .filter((q) => q.gt(q.field(\"updated_at\"), fifteenSecondsAgo))\n      .collect();\n    return onlineUsers;\n  },\n});\n"},"output":{"success":true},"callProviderMetadata":{"vertex":{"thoughtSignature":""}}}}
